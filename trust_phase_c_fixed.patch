+    assert s["verification"] == {"state": "NOT_SUPPORTED", "tier": None, "supported": False}
+    assert s["trade"]["rating"] == {"state": "INSUFFICIENT_DATA", "count": 0,
+                                    "average": None, "min_count": 3}
