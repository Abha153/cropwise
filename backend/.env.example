# CropWise backend configuration
# Copy this file to .env and adjust if needed. Sensible defaults are already
# provided so the demo runs with zero configuration.

# Secret key used to sign JWT auth tokens. Change this in any real deployment.
SECRET_KEY=cropwise-hackathon-demo-secret-key-change-me

# Access token lifetime, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL database, hosted on Supabase -- this is CropWise's MVP
# database; there is no SQLite fallback anymore, and the backend will
# refuse to start without DATABASE_URL set.
#
# Get your own connection string from the Supabase dashboard:
# Project Settings -> Database -> Connect -> "Session pooler" (recommended
# for a long-running server like Render; use the transaction pooler on
# port 6543 only if you specifically need it, and switch SQLAlchemy to
# NullPool if you do). Replace <project-ref> and <PASSWORD> below with
# your own project's values -- NEVER commit your real password here or
# anywhere else; this file only ever holds placeholders.
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Comma separated list of origins allowed to call the API from the browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin console credentials (protects every /admin/* route, including the
# impact dashboard and the login-activity endpoints). REQUIRED in any real
# deployment. Uncomment both lines below and set your own values here (or
# directly as environment variables in Render's dashboard) -- never commit
# real credentials to source control.
#
# Left commented out (not blank -- an empty value is not the same as unset),
# the backend falls back to a publicly-documented demo default and logs a
# warning on startup. That fallback only exists for a zero-config local
# demo run and must never be relied on for a reachable deployment.
# ADMIN_USERNAME=your-admin-username
# ADMIN_PASSWORD=your-strong-admin-password

# Live government mandi-price data. As of the multi-source update, two
# INDEPENDENT sources are queried CONCURRENTLY whenever both are
# configured -- data.gov.in and Agmarknet-via-CEDA -- and their results
# combined with source attribution (never one silently overriding the
# other; see app/services/mandi_directory.py::fetch_price_result for the
# full contract). Each source is entirely optional and independent: set
# either, both, or neither. With neither set, CropWise runs entirely on
# the seeded demo dataset (clearly labeled as such).
#
# Source 1: data.gov.in ("Current Daily Price of Various Commodities from
# Various Markets" API, Agmarknet-sourced). Get your own free key at
# https://data.gov.in/user/register then https://data.gov.in/user/myapikeys.
# Set MARKET_DATA_SOURCE=live to require validated data.gov.in responses.
# In live mode, a missing key, timeout, invalid response, or empty result is
# reported as unavailable; seeded demo prices are never substituted silently.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_DISTRICT_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24
MARKET_DATA_SOURCE=demo

# Source 2: Agmarknet, accessed via CEDA's AGMARKNET API (an aggregator
# that re-serves official Agmarknet mandi data through a documented REST
# API -- CropWise has no separate/direct Agmarknet API integration, so
# there is intentionally only ONE key for this source, not a second
# "AGMARKNET_API_KEY"; CEDA_API_KEY IS the Agmarknet configuration).
CEDA_API_KEY=
