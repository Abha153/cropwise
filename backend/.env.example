# CropWise backend configuration
# Copy this file to .env and adjust if needed. Sensible defaults are already
# provided so the demo runs with zero configuration.

# Secret key used to sign JWT auth tokens. Change this in any real deployment.
SECRET_KEY=cropwise-hackathon-demo-secret-key-change-me

# Access token lifetime, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite database file (relative to the backend/ folder). No external DB
# server is required for the demo.
DATABASE_URL=sqlite:///./cropwise.db

# Comma separated list of origins allowed to call the API from the browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin console credentials (protects every /admin/* route, including the
# impact dashboard and the login-activity endpoints). REQUIRED in any real
# deployment. Uncomment both lines below and set your own values here (or
# directly as environment variables in Render's dashboard) -- never commit
# real credentials to source control.
#
# Left commented out (not blank -- an empty value is not the same as unset),
# the backend falls back to a publicly-documented demo default and logs a
# warning on startup. That fallback only exists for a zero-config local
# demo run and must never be relied on for a reachable deployment.
# ADMIN_USERNAME=your-admin-username
# ADMIN_PASSWORD=your-strong-admin-password

# Live government mandi-price data (data.gov.in "Current Daily Price of
# Various Commodities from Various Markets" API, Agmarknet-sourced).
# Get your own free key at https://data.gov.in/user/register then
# https://data.gov.in/user/myapikeys -- leave DATA_GOV_IN_API_KEY empty to
# run entirely on the seeded demo dataset (clearly labeled as such).
# Set MARKET_DATA_SOURCE=live to have CropWise attempt a live fetch first
# and fall back to demo data (labeled per-record) when unavailable.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_DISTRICT_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24
MARKET_DATA_SOURCE=demo
